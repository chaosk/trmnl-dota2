#!/usr/bin/env sh
set -e
cd "$(dirname "$0")/.."
if command -v trmnlp >/dev/null 2>&1; then
  exec trmnlp "$@"
fi
TRMNLP_CONFIG="${TRMNLP_CONFIG:-$HOME/.config/trmnlp}"
mkdir -p "$TRMNLP_CONFIG"
exec docker run --rm -it \
  --pull always \
  --publish 4567:4567 \
  --volume "$(pwd):/plugin" \
  --volume "$TRMNLP_CONFIG:/root/.config/trmnlp" \
  trmnl/trmnlp "$@"
